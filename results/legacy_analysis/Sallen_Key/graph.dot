"100" [label="VO", fillcolor="#dcfce7"];
"2" [label="2", fillcolor="#dbeafe"];
"3" [label="3", fillcolor="#dbeafe"];
"4" [label="4", fillcolor="#dbeafe"];
"5" [label="5", fillcolor="#dbeafe"];
"-100" -> "1" [label="1", tooltip="1"];
"-5" -> "5" [label="(1/(G3+G4))", tooltip="(1/(G3+G4))"];
"-4" -> "4" [label="(1/(G2+sC2))", tooltip="(1/(G2+sC2))"];
"-2" -> "2" [label="(1/(G1+sC1+G2))", tooltip="(1/(G1+sC1+G2))"];
